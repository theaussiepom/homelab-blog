---
interface Props {
  kind: 'timeline' | 'storage' | 'startup';
}

const { kind } = Astro.props;
const stages = [
  {
    title: 'A VM on the NAS',
    detail: 'Home Assistant in its own virtual machine',
    reason: 'More freedom to run services and improve coverage',
    icon: 'nas',
  },
  {
    title: 'Containers on the NAS',
    detail: 'Home Assistant Core in Docker, without add-ons',
    tradeoff: 'More setup. Much more control.',
    reason: 'Old Docker, driver upkeep and processor limits',
    icon: 'nas',
  },
  {
    title: 'Docker on the ROG',
    detail: 'Applications on the ROG; shared files on the NAS',
    reason: 'More deliberate network isolation',
    icon: 'server',
  },
  {
    title: 'Swarm for networking',
    detail: 'Private container networking across the ROG and Pis',
    reason: 'Separate service groups; changes reviewed in Git',
    icon: 'network',
  },
  {
    title: 'Proxmox, managed through code',
    detail: 'The current build, with migration still in progress',
    icon: 'code',
  },
];
const paths: Record<string, string> = {
  nas: 'M6 3h20v26H6z M10 10h12 M10 17h12 M11 24h1 M17 24h5',
  server: 'M5 5h22v16H5z M10 27h12 M16 21v6 M10 10h12 M10 15h7',
  network: 'M12 3h8v8h-8z M2 21h8v8H2z M22 21h8v8h-8z M16 11v6 M6 21v-4h20v4',
  code: 'M10 8 3 16l7 8 M22 8l7 8-7 8 M19 4l-6 24',
};
---

<figure class:list={['journey-figure', `journey-${kind}`]}>
  {kind === 'timeline' && (
    <>
      <div class="figure-label">01 / The five versions</div>
      <ol class="journey-stages">
        {stages.map((stage, index) => (
          <li>
            <div class="journey-node">
              <span class="stage-number" aria-hidden="true">
                {index + 1}
              </span>
              <svg class="journey-icon" viewBox="0 0 32 32" aria-hidden="true">
                <path d={paths[stage.icon]} />
              </svg>
              <div>
                <strong>{stage.title}</strong>
                <span>{stage.detail}</span>
                {stage.tradeoff && <span>{stage.tradeoff}</span>}
              </div>
              {index === 4 && <span class="progress-label">In progress</span>}
            </div>
            {stage.reason && (
              <p class="journey-transition">
                <span aria-hidden="true">↓</span>
                <span>{stage.reason}</span>
              </p>
            )}
          </li>
        ))}
      </ol>
      <figcaption>
        The five stages, with the reason for each move. The Proxmox build is
        still in progress.
      </figcaption>
    </>
  )}
  {kind === 'storage' && (
    <>
      <div class="figure-label">02 / The NAS changed jobs</div>
      <div class="storage-comparison">
        <section class="storage-era" aria-label="Before the move">
          <p class="era-label">Before the move</p>
          <div class="machine-node">
            <svg class="journey-icon" viewBox="0 0 32 32" aria-hidden="true">
              <path d={paths.nas} />
            </svg>
            <strong>Synology NAS</strong>
            <span>Runs applications</span>
            <span>Stores their files</span>
          </div>
        </section>
        <section class="storage-era" aria-label="After the move">
          <p class="era-label">After the move</p>
          <div class="storage-pair">
            <div class="machine-node">
              <svg class="journey-icon" viewBox="0 0 32 32" aria-hidden="true">
                <path d={paths.server} />
              </svg>
              <strong>ASUS ROG</strong>
              <span>Runs applications</span>
            </div>
            <div class="file-connection">
              <svg viewBox="0 0 20 48" aria-hidden="true">
                <path d="M10 3v42 M3 11l7-8 7 8 M3 37l7 8 7-8" />
              </svg>
              <span>NFS file access</span>
            </div>
            <div class="machine-node">
              <svg class="journey-icon" viewBox="0 0 32 32" aria-hidden="true">
                <path d={paths.nas} />
              </svg>
              <strong>Synology NAS</strong>
              <span>Stores shared files</span>
            </div>
          </div>
        </section>
      </div>
      <figcaption>
        The ROG took over running the applications. The NAS kept their shared
        files, so those applications still needed both machines and the
        connection between them.
      </figcaption>
    </>
  )}
  {kind === 'startup' && (
    <>
      <div class="figure-label">03 / The order mattered</div>
      <ol class="startup-chain">
        <li>
          <span class="step-label">First</span>
          <strong>Network ready</strong>
          <span>The server can reach the NAS</span>
        </li>
        <li>
          <span class="step-label">Then</span>
          <strong>NAS share mounted</strong>
          <span>The expected files are available</span>
        </li>
        <li>
          <span class="step-label">Then</span>
          <strong>Applications start</strong>
          <span>Services can use their real data</span>
        </li>
      </ol>
      <figcaption>
        The simplified dependency order for services using NAS data. These waits
        protected applications from starting before their storage was available.
      </figcaption>
    </>
  )}
</figure>

<style>
  .journey-figure {
    margin: 2rem 0;
    padding: 1.25rem;
    border: 1px solid var(--hl-rule-soft);
    font: 1rem/1.5 var(--sl-font);
    color: var(--hl-ink);
    overflow-wrap: anywhere;
  }
  .journey-figure :is(p, ol, li, svg, div, section, span, strong) {
    margin: 0;
  }
  .figure-label {
    color: var(--hl-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-block-end: 1.25rem !important;
  }
  .journey-figure :is(ol, li) {
    padding: 0;
    list-style: none;
  }
  .journey-node {
    display: grid;
    grid-template-columns: 2rem 2rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    padding: 1rem;
    border-inline-start: 3px solid var(--hl-accent);
    background: var(--hl-callout);
  }
  .stage-number {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--hl-accent);
    color: var(--hl-accent);
    font-weight: 700;
  }
  .journey-icon {
    display: block;
    width: 2rem;
    height: 2rem;
    flex-shrink: 0;
    color: var(--hl-accent);
  }
  svg path {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .journey-figure strong {
    display: block;
    font-size: 1rem;
  }
  .journey-node div > span,
  .machine-node > span,
  .startup-chain li > span:last-child {
    display: block;
    font-size: 0.875rem;
    margin-block-start: 0.25rem;
  }
  .journey-transition {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
  }
  .journey-transition > span:first-child {
    width: 2rem;
    flex-shrink: 0;
    text-align: center;
    color: var(--hl-accent);
    font-size: 1.25rem;
  }
  .progress-label {
    grid-column: 3;
    justify-self: start;
    border-block-end: 2px dashed var(--hl-accent);
    color: var(--hl-accent);
    font-size: 0.75rem;
  }
  figcaption {
    margin-block-start: 1rem;
    font-size: 0.875rem;
    line-height: 1.6;
  }
  .storage-comparison {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: 1.5rem;
  }
  .era-label {
    font-size: 0.875rem;
    font-weight: 700;
    margin-block-end: 0.75rem !important;
  }
  .machine-node {
    padding: 1rem;
    border: 1px solid var(--hl-accent);
    background: var(--hl-callout);
  }
  .machine-node .journey-icon {
    margin-block-end: 0.5rem;
  }
  .file-connection {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.75rem;
    font-size: 0.875rem;
  }
  .file-connection svg {
    width: 1.25rem;
    height: 2.5rem;
    color: var(--hl-accent);
  }
  .startup-chain {
    display: grid;
    gap: 2rem;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }
  .startup-chain li {
    position: relative;
    padding: 1rem;
    border-block-start: 3px solid var(--hl-accent);
    background: var(--hl-callout);
  }
  .startup-chain li + li::before {
    content: '→';
    position: absolute;
    inset-inline-start: -1.5rem;
    inset-block-start: 2.5rem;
    color: var(--hl-accent);
  }
  .step-label {
    display: block;
    color: var(--hl-accent);
    font-size: 0.75rem;
    margin-block-end: 0.5rem !important;
  }
  @media (max-width: 40rem) {
    .journey-figure {
      padding: 1rem;
    }
    .journey-node {
      grid-template-columns: 1.5rem minmax(0, 1fr);
      gap: 0.75rem;
      padding: 0.75rem;
    }
    .journey-node .journey-icon {
      display: none;
    }
    .stage-number {
      width: 1.5rem;
      height: 1.5rem;
    }
    .progress-label {
      grid-column: 2;
    }
    .journey-transition {
      gap: 0.75rem;
      padding-inline: 0.75rem;
    }
    .journey-transition > span:first-child {
      width: 1.5rem;
    }
    .storage-comparison,
    .startup-chain {
      grid-template-columns: 1fr;
    }
    .storage-era + .storage-era {
      border-block-start: 1px solid var(--hl-rule-soft);
      padding-block-start: 1.25rem;
    }
    .startup-chain li + li::before {
      content: '↓';
      inset-inline-start: 1rem;
      inset-block-start: -1.875rem;
    }
  }
  @media print {
    .journey-figure {
      break-inside: avoid;
    }
  }
</style>
