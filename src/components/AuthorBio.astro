---
import { Image } from 'astro:assets';
import portrait from '../assets/authors/ben.jpg';
import { author, isSiteAuthor } from '../lib/author.mjs';
import AuthorLinks from './AuthorLinks.astro';

const { data } = Astro.locals.starlightRoute.entry;
const showBio =
  data.articleType !== 'page' &&
  data.authors?.some(({ name }) => isSiteAuthor(name));
---

{showBio && (
  <section
    class="hl-author-bio"
    aria-labelledby="author-bio-heading"
    data-pagefind-ignore
  >
    <div class="hl-author-heading">
      <h2 id="author-bio-heading">About {author.name}</h2>
    </div>
    <Image
      class="hl-author-portrait"
      src={portrait}
      alt={author.portraitAlt}
      width={112}
      height={112}
      widths={[64, 112, 128, 224]}
      sizes="(max-width: 36rem) 4rem, 7rem"
      loading="lazy"
    />
    <div class="hl-author-copy">
      <p>{author.shortBio}</p>
      <AuthorLinks includeAbout />
    </div>
  </section>
)}

<style>
  .hl-author-bio {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    grid-template-areas:
      'portrait heading'
      'portrait copy';
    align-items: start;
    gap: 0.75rem 1.5rem;
    margin-block-start: 2rem;
    padding: clamp(1rem, 4vw, 1.5rem);
    border: 1px solid var(--hl-rule-soft);
    border-radius: 0.25rem;
    background: var(--hl-callout);
    color: var(--hl-ink);
  }
  .hl-author-heading {
    grid-area: heading;
  }
  h2 {
    margin: 0;
    font: 700 1.25rem/1.25 var(--sl-font);
  }
  .hl-author-portrait {
    grid-area: portrait;
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hl-rule-soft);
    border-radius: 0.25rem;
  }
  .hl-author-copy {
    grid-area: copy;
  }
  p {
    margin: 0;
    font: 1.125rem/1.7 var(--hl-reading);
  }
  p + p {
    margin-block-start: 0.75rem;
  }
  @media (max-width: 36rem) {
    .hl-author-bio {
      grid-template-columns: 4rem minmax(0, 1fr);
      grid-template-areas:
        'portrait heading'
        'copy copy';
      column-gap: 0.75rem;
    }
    .hl-author-heading {
      align-self: center;
    }
  }
</style>
