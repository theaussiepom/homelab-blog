---
import { Image } from 'astro:assets';
import tabletDashboard from '../assets/articles/homelab-proxmox-journey/living-tablet-dashboard.png';
---

<figure class="journey-tablet">
  <Image
    src={tabletDashboard}
    alt="The living-room tablet dashboard, showing lighting scenes, blind controls, air conditioning and a household energy-flow display."
    widths={[360, 700, 1400]}
    sizes="(max-width: 700px) calc(100vw - 2rem), 700px"
    loading="lazy"
  />
  <figcaption>
    On my living-room tablet: lighting scenes, blinds, climate and energy in one
    view. <a href={tabletDashboard.src}>View full size</a>.
  </figcaption>
</figure>

<style>
  .journey-tablet {
    margin: 2rem 0;
  }
  .journey-tablet :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hl-rule-soft);
  }
  figcaption {
    margin-block-start: 0.75rem;
    color: var(--hl-ink);
    font: 0.875rem/1.6 var(--sl-font);
  }
</style>
