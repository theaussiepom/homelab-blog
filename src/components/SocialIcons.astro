---
import config from 'virtual:starlight/user-config';
import { Icon } from '@astrojs/starlight/components';
---

{config.social?.map(({ label, href, icon }) => (
  <a
    class="hl-social-link"
    {href}
    aria-label={label}
    title={icon === 'rss' ? 'Subscribe by RSS' : label}
    rel={icon === 'rss' ? 'alternate' : 'me'}
  >
    <Icon name={icon} aria-hidden="true" />
    <span class="hl-social-text" aria-hidden="true">
      {icon === 'rss'
        ? 'RSS'
        : icon === 'github'
          ? 'GitHub'
          : icon === 'linkedin'
            ? 'LinkedIn'
            : label}
    </span>
  </a>
))}

<style>
  .hl-social-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-inline-size: 2.75rem;
    min-block-size: 2.75rem;
    flex-shrink: 0;
    color: var(--sl-color-text-accent);
    border-radius: 0.25rem;
  }
  .hl-social-text {
    display: none;
  }
  .hl-social-link:hover {
    color: var(--sl-color-white);
  }
  .hl-social-link :global(svg) {
    width: 1.25rem;
    height: 1.25rem;
  }
</style>
