---
import { Image } from 'astro:assets';
import portrait from '../assets/authors/ben.jpg';
import { author, aboutParagraphs } from '../lib/author.mjs';
import AuthorLinks from './AuthorLinks.astro';
---

<div class="hl-about-author">
  <div class="hl-about-opening">
    <Image
      src={portrait}
      alt={author.portraitAlt}
      width={128}
      height={128}
      widths={[96, 128, 192, 256]}
      sizes="(max-width: 36rem) 6rem, 8rem"
      class="hl-about-portrait"
    />
    <p>{aboutParagraphs[0]}</p>
  </div>
  {aboutParagraphs.slice(1).map((paragraph) => (
    <p>{paragraph}</p>
  ))}
  <AuthorLinks />
</div>

<style>
  .hl-about-opening {
    display: grid;
    grid-template-columns: 8rem minmax(0, 1fr);
    align-items: start;
    gap: 1.5rem;
    margin-block-start: 1.5rem;
  }
  .hl-about-portrait {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--hl-rule-soft);
    border-radius: 0.25rem;
  }
  p {
    margin-block: 0 1em;
  }
  @media (max-width: 36rem) {
    .hl-about-opening {
      display: block;
    }
    .hl-about-portrait {
      width: 6rem;
      margin-block-end: 1rem;
    }
  }
</style>
