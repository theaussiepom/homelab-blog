---
import { brandAsset } from '../lib/site.mjs';
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a class="hl-brand" href={siteTitleHref}>
  <picture class="hl-brand-light" aria-hidden="true">
    <source
      media="(max-width: 28rem)"
      srcset={brandAsset('logos/svg/tap-compact-on-light.svg')}
      width="653"
      height="208"
    />
    <img
      src={brandAsset('logos/svg/tap-masthead-on-light.svg')}
      width="514"
      height="104"
      alt=""
      decoding="async"
    />
  </picture>
  <picture class="hl-brand-dark" aria-hidden="true">
    <source
      media="(max-width: 28rem)"
      srcset={brandAsset('logos/svg/tap-compact-on-dark.svg')}
      width="653"
      height="208"
    />
    <img
      src={brandAsset('logos/svg/tap-masthead-on-dark.svg')}
      width="514"
      height="104"
      alt=""
      decoding="async"
    />
  </picture>
  <span class="sr-only" translate="no">
    {siteTitle}
  </span>
</a>
