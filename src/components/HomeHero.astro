---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { getCollection } from 'astro:content';

const featuredId = 'architecture/homelab-proxmox-journey';
const articles =
  Astro.url.pathname === '/'
    ? (
        await getCollection(
          'docs',
          ({ data }) =>
            ['guide', 'architecture', 'investigation', 'post'].includes(
              data.articleType,
            ) && !data.draft,
        )
      ).sort(
        (a, b) => (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0),
      )
    : [];
const featuredArticle = articles.find(({ id }) => id === featuredId);
const moreArticles = articles.filter(({ id }) => id !== featuredId);
---

{Astro.url.pathname === '/' ? (
  <div class="hl-home">
    <section class="hl-hero" aria-labelledby="_top">
      <div>
        <p class="hl-kicker">Home automation &amp; self-hosting</p>
        <h1 id="_top" data-page-title>
          There’s always one more thing to build.
        </h1>
        <p class="hl-intro">
          I’m Ben. I write about home automation, self-hosted services and the
          decisions behind them, from the first useful setup to the engineering
          that keeps it running.
        </p>
      </div>
      {featuredArticle && !featuredArticle.data.draft && (
        <div class="hl-feature">
          <svg
            viewBox="0 0 400 120"
            class="hl-motif"
            aria-hidden="true"
            focusable="false"
          >
            <g fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M55 60H345M150 20V100M250 20V100M150 20H250M150 100H250" />
              <circle cx="55" cy="60" r="25" />
              <rect x="125" y="35" width="50" height="50" />
              <circle cx="250" cy="60" r="25" />
              <rect x="320" y="35" width="50" height="50" />
            </g>
          </svg>
          <p class="hl-kicker">The story so far</p>
          <h2>
            <a href={`/${featuredId}/`}>{featuredArticle.data.title}</a>
          </h2>
          <p>{featuredArticle.data.description}</p>
          <a class="hl-read" href={`/${featuredId}/`}>
            Read the homelab story <span aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </section>
    {moreArticles.length > 0 && (
      <>
        <div class="hl-section-label">
          <h2>Keep exploring</h2>
        </div>
        <div class="hl-discovery">
          {moreArticles.map(({ id, data }) => (
            <section>
              <h3>
                <a href={`/${id}/`}>{data.title}</a>
              </h3>
              <p>{data.description}</p>
            </section>
          ))}
        </div>
      </>
    )}
  </div>
) : (
  <DefaultHero>
    <slot />
  </DefaultHero>
)}
