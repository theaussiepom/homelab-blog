---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { getEntry } from 'astro:content';

const featuredId = 'architecture/homelab-proxmox-journey';
const featuredArticle =
  Astro.url.pathname === '/' ? await getEntry('docs', featuredId) : undefined;
const topics = [
  [
    'Start Here',
    '/start-here/',
    'A map of the notes',
    'Find your way through the publication.',
  ],
  [
    'Architecture',
    '/architecture/',
    'Keep the boundaries clear',
    'Understand responsibilities and design decisions.',
  ],
];
---

{Astro.url.pathname === '/' ? (
  <div class="hl-home">
    <nav class="hl-topics" aria-label="Publication sections">
      {topics.map(([label, url]) => (
        <a href={url}>{label}</a>
      ))}
    </nav>
    <section class="hl-hero" aria-labelledby="_top">
      <div>
        <p class="hl-kicker">Notes from a curious homelab</p>
        <h1 id="_top" data-page-title>
          Small systems.
          <br />
          Big understanding.
        </h1>
        <p class="hl-intro">
          Practical guides and honest investigations by theaussiepom. Exploring
          how small systems work, and sharing what the evidence tells us.
        </p>
      </div>
      {featuredArticle && !featuredArticle.data.draft && (
        <div class="hl-feature">
          <svg
            viewBox="0 0 400 120"
            class="hl-motif"
            aria-hidden="true"
            focusable="false"
          >
            <g fill="none" stroke="currentColor" stroke-width="1.5">
              <path d="M55 60H345M150 20V100M250 20V100M150 20H250M150 100H250" />
              <circle cx="55" cy="60" r="25" />
              <rect x="125" y="35" width="50" height="50" />
              <circle cx="250" cy="60" r="25" />
              <rect x="320" y="35" width="50" height="50" />
            </g>
          </svg>
          <p class="hl-kicker">Architecture</p>
          <h2>
            <a href={`/${featuredId}/`}>{featuredArticle.data.title}</a>
          </h2>
          <p>{featuredArticle.data.description}</p>
          <a class="hl-read" href={`/${featuredId}/`}>
            Read the homelab story <span aria-hidden="true">→</span>
          </a>
        </div>
      )}
    </section>
    <div class="hl-section-label">
      <h2>Explore the notes</h2>
    </div>
    <div class="hl-discovery">
      {topics.map(([label, url, title, description]) => (
        <section>
          <p class="hl-kicker">{label}</p>
          <h3>
            <a href={url}>{title}</a>
          </h3>
          <p>{description}</p>
        </section>
      ))}
    </div>
  </div>
) : (
  <DefaultHero>
    <slot />
  </DefaultHero>
)}
