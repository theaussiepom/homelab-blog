---
import DefaultHero from '@astrojs/starlight/components/Hero.astro';
import { getCollection } from 'astro:content';
import { isPublishedArticle } from '../lib/editorial.mjs';
import HeroNote from './HeroNote.astro';
import { supportingLine, brandAsset } from '../lib/site.mjs';
import { author } from '../lib/author.mjs';

const featuredId = 'architecture/homelab-proxmox-journey';
const articles =
  Astro.url.pathname === '/'
    ? (
        await getCollection('docs', ({ data }) => isPublishedArticle(data))
      ).sort(
        (a, b) =>
          (b.data.date?.getTime() ?? 0) - (a.data.date?.getTime() ?? 0) ||
          a.data.title.localeCompare(b.data.title),
      )
    : [];
const featuredArticle = articles.find(({ id }) => id === featuredId);
const moreArticles = articles.filter(({ id }) => id !== featuredId);
---

{Astro.url.pathname === '/' ? (
  <div class="hl-home">
    <section class="hl-hero" aria-labelledby="_top">
      <div class="hl-hero-decoration" aria-hidden="true"></div>
      <div class="hl-hero-copy">
        <div class="hl-hero-author">
          <img
            src={brandAsset('icons/svg/tap-portrait-lilac.svg')}
            width="512"
            height="512"
            alt=""
          />
          <span>{author.name}</span>
        </div>
        <h1 id="_top" data-page-title>
          There’s always one more thing to build.
        </h1>
        <p class="hl-supporting-line">{supportingLine}</p>
        <p class="hl-intro">
          I’m Ben, a software engineer who likes understanding how things work,
          trying ideas and making them useful.
        </p>
        <a class="hl-about-link" href={author.aboutPath}>
          More about me <span aria-hidden="true">→</span>
        </a>
      </div>
      {featuredArticle && (
        <>
          <HeroNote />
          <div class="hl-feature">
            <p class="hl-kicker">The story so far</p>
            <h2>
              <a href={`/${featuredId}/`}>{featuredArticle.data.title}</a>
            </h2>
            <p class="hl-feature-meta">
              <span>{featuredArticle.data.articleType}</span>
              {featuredArticle.data.date && (
                <>
                  {' '}
                  ·{' '}
                  <time
                    datetime={featuredArticle.data.date
                      .toISOString()
                      .slice(0, 10)}
                  >
                    {new Intl.DateTimeFormat('en-AU', {
                      dateStyle: 'long',
                      timeZone: 'UTC',
                    }).format(featuredArticle.data.date)}
                  </time>
                </>
              )}
            </p>
            <p class="hl-feature-description">
              {featuredArticle.data.description}
            </p>
            <a class="hl-read" href={`/${featuredId}/`}>
              Read the homelab story <span aria-hidden="true">→</span>
            </a>
          </div>
        </>
      )}
    </section>
    {moreArticles.length > 0 && (
      <>
        <div class="hl-section-label">
          <h2>Keep exploring</h2>
        </div>
        <div class="hl-discovery">
          {moreArticles.map(({ id, data }) => (
            <section>
              <h3>
                <a href={`/${id}/`}>{data.title}</a>
              </h3>
              <p>{data.description}</p>
            </section>
          ))}
        </div>
      </>
    )}
  </div>
) : (
  <DefaultHero>
    <slot />
  </DefaultHero>
)}
